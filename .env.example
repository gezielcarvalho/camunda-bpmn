# Camunda 8 Docker Environment Configuration
# Copy this file to .env and modify as needed

# Images (pin for repeatability)
ZEEBE_IMAGE=camunda/zeebe:8.6.3
OPERATE_IMAGE=camunda/operate:8.6.3
TASKLIST_IMAGE=camunda/tasklist:8.6.3
IDENTITY_IMAGE=camunda/identity:8.6.3
ELASTIC_IMAGE=elasticsearch:8.12.2

# Dev credentials (CHANGE IN PRODUCTION)
ELASTIC_PASSWORD=changeme
IDP_ADMIN_USER=admin
IDP_ADMIN_PASSWORD=admin

# Elasticsearch configuration
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Zeebe configuration
ZEEBE_BROKER_CLUSTER_PARTITIONS=1
ZEEBE_BROKER_CLUSTER_REPLICATION_FACTOR=1
ZEEBE_BROKER_CLUSTER_CLUSTER_SIZE=1

# Network settings
ZEEBE_HOST=zeebe
ZEEBE_PORT=26500
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Identity/Keycloak configuration
KEYCLOAK_INIT_OPERATE_SECRET=the-operate-secret
KEYCLOAK_INIT_OPERATE_ROOT_URL=http://localhost:8081
KEYCLOAK_INIT_TASKLIST_SECRET=the-tasklist-secret
KEYCLOAK_INIT_TASKLIST_ROOT_URL=http://localhost:8082
KEYCLOAK_INIT_OPTIMIZE_SECRET=the-optimize-secret
KEYCLOAK_INIT_OPTIMIZE_ROOT_URL=http://localhost:8083
